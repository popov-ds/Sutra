# MAX Bot API (platform-api2.max.ru)
MAX_BOT_TOKEN=
# Публичное имя бота в MAX (не URL!) для кнопки open_app «Моя Sutra» — как в кабинете Mini App
# Если пусто — «Моя Sutra» откроется link на PUBLIC_BASE_URL/miniapp/
# MAX_BOT_WEB_APP=id123456_bot

# HTTPS public URL of this Node service (Mini App + webhook)
PUBLIC_BASE_URL=https://your-domain.example
# Форма поддержки: SUPPORT_PUBLIC_URL или PUBLIC_BASE_URL/support (nginx → DreamerSoftSupport :18083)
# SUPPORT_PUBLIC_URL=https://support.dreamer-soft.pro

HTTP_PORT=8090
# VPS (docker-compose.vps.yml): 18081 + HTTP_BIND=127.0.0.1 в compose
# PUBLIC_BASE_URL=https://sutra.max.dreamer-soft.pro

# Webhook (production). Secret must match X-Max-Bot-Api-Secret from subscriptions.
WEBHOOK_SECRET=
MAX_USE_POLLING=1

# Launch token for Mini App → /api/me (HMAC)
LAUNCH_TOKEN_SECRET=change-me-long-random

# Supabase (Mini App talks to Supabase directly when Pro; URL/ключ — из кабинета Supabase)
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Postgres (VPS: sutra_max_bot, порт 55433, см. docker-compose.vps.yml)
# DATABASE_URL=postgresql://sutra:PASSWORD@127.0.0.1:55433/sutra_max_bot
# POSTGRES_PASSWORD=случайный_пароль

# Промокоды: КОД:дни[:макс_активаций]
# PROMO_CODES=BETA30:30,WELCOME14:14:100

# ЮKassa (Pro в чате MAX)
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
# Суммы строго с копейками: 299.00 (не 299)
PRO_MONTH_RUB=
PRO_YEAR_RUB=
# Чеки 54-ФЗ в API (1 по умолчанию; 0 — без блока receipt)
YOOKASSA_FISCALIZATION=1
YOOKASSA_VAT_CODE=1
# Опционально, если не вводят email на странице оплаты
# YOOKASSA_DEFAULT_RECEIPT_EMAIL=
# Webhook в кабинете ЮKassa: PUBLIC_BASE_URL/webhooks/yookassa
# Return URL задаётся в API: PUBLIC_BASE_URL/pay/return