# Отдельный vhost для Sutra MAX Bot (не solver, не Yoga).
# cp deploy/vps/nginx-sutra.max.dreamer-soft.conf.example /etc/nginx/sites-available/sutra.max.dreamer-soft.pro
# ln -s /etc/nginx/sites-available/sutra.max.dreamer-soft.pro /etc/nginx/sites-enabled/
# DNS (reg.ru, зона dreamer-soft.pro): A sutra.max → IP VPS
# certbot --nginx -d sutra.max.dreamer-soft.pro

server {
    listen 80;
    server_name sutra.max.dreamer-soft.pro;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    server_name sutra.max.dreamer-soft.pro;

    ssl_certificate     /etc/letsencrypt/live/sutra.max.dreamer-soft.pro/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/sutra.max.dreamer-soft.pro/privkey.pem;

    client_max_body_size 4m;
    large_client_header_buffers 8 32k;

    # Форма поддержки (DreamerSoftSupport на :18083), как у YogaScheduler
    location /support/ {
        proxy_pass http://127.0.0.1:18083/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        client_max_body_size 64k;
    }

    location / {
        proxy_pass http://127.0.0.1:18081;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header Authorization $http_authorization;
        proxy_set_header X-Max-Init-Data $http_x_max_init_data;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
