{
  "name": "sutra-max",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "start:bot": "node dist/index.js",
    "build": "tsc -p tsconfig.json && npm run build:miniapp",
    "build:miniapp": "vite build -c miniapp/vite.config.ts",
    "dev:miniapp": "vite -c miniapp/vite.config.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.119.0",
    "dotenv": "^16.4.7",
    "sql.js": "^1.13.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.3"
  }
}