{
  "name": "sutra",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@react-native-community/datetimepicker": "9.2.1",
    "@react-native-picker/picker": "2.11.4",
    "@supabase/supabase-js": "^2.119.0",
    "expo": "~58.0.22",
    "expo-build-properties": "~58.0.12",
    "expo-constants": "~58.0.14",
    "expo-linking": "~58.0.15",
    "expo-notifications": "~58.1.7",
    "expo-router": "~58.0.29",
    "expo-secure-store": "~58.0.2",
    "expo-sqlite": "~58.0.15",
    "expo-status-bar": "~58.0.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.1",
    "react-native-web": "^0.21.4"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "~19.3.0",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~58.0.4",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android --variant rustoreDebug",
    "android:rustore": "expo run:android --variant rustoreDebug",
    "android:play": "expo run:android --variant playDebug",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "test": "tsc -p tsconfig.test.json && node --test .test-dist/domain.test.js",
    "lint": "expo lint",
    "build:rustore": "powershell -ExecutionPolicy Bypass -File scripts/build-release.ps1 -Flavor rustore -Artifact apk",
    "build:play": "powershell -ExecutionPolicy Bypass -File scripts/build-release.ps1 -Flavor play -Artifact aab",
    "build:play:apk": "powershell -ExecutionPolicy Bypass -File scripts/build-release.ps1 -Flavor play -Artifact apk",
    "build:all": "powershell -ExecutionPolicy Bypass -File scripts/build-all-stores.ps1",
    "build:debug:rustore": "powershell -ExecutionPolicy Bypass -File scripts/build-debug.ps1 -Flavor rustore",
    "build:debug:play": "powershell -ExecutionPolicy Bypass -File scripts/build-debug.ps1 -Flavor play",
    "verify:supabase": "node scripts/verify-supabase.mjs",
    "icon:refresh": "powershell -ExecutionPolicy Bypass -File scripts/refresh-app-icon.ps1"
  },
  "private": true
}
